@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityTexts> T
@page "/Account/ResetPasswordConfirmation"
<PageTitle>@T["Reset password confirmation"]</PageTitle>

<h1>@T["Reset password confirmation"]</h1>
<p role="alert">
    Your password has been reset. Please <a href="Account/Login">@T["click here to log in"]</a>.
</p>
