@*
 * Step2.7 UI Admin Userverwaltung erstellen
 *@
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityTexts> T

@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BlazorIdentityDeutsch.Data

@attribute [Authorize(Roles = ApplicationRoles.Admin)]
@rendermode InteractiveServer

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@T["Usermanagement"]</PageTitle>

<div class="page-title">
    <span class="bid bid-person-gear" aria-hidden="true"></span>
    <span>@T["Usermanagement"]</span>
</div>

@if (!string.IsNullOrEmpty(message)) {
    <div class="alert @(isError ? "alert-danger" : "alert-success")">
        @message
    </div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@T["E-Mail"]</th>
            <th>@T["Current Role"]</th>
            <th>@T["Confirmed"]</th>
            <th>@T["New Role"]</th>
            <th>@T["Action"]</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in users) {
            var isCurrentAdmin = item.Id == currentUserId && item.Role == ApplicationRoles.Admin;

            <tr @key="item.Id">
                <td>
                    @item.Email

                    @if (item.Id == currentUserId) {
                        <span class="badge bg-secondary ms-2">@T["Me"]</span>
                    }
                </td>

                <td>@T[item.Role]</td>

                <td>
                    <div class="form-check form-switch">
                        <input class="form-check-input"
                               type="checkbox"
                               checked="@item.EmailConfirmed"
                               disabled="@(busy || isCurrentAdmin)"
                               @onchange="async e => await ChangeEmailConfirmedAsync(item, e.Value is true)" />

                        <label class="form-check-label">
                            @(item.EmailConfirmed ? @T["Confirmed"] : @T["Unconfirmed"])
                        </label>
                    </div>
                </td>

                <td>
                    <select class="form-select form-select-sm" @bind="item.SelectedRole" disabled="@busy">
                        @foreach (var role in ApplicationRoles.All) {
                            <option value="@role" disabled="@(isCurrentAdmin && role != ApplicationRoles.Admin)">
                                @T[role]
                            </option>
                        }
                    </select>
                </td>

                <td>
                    <button class="btn btn-success btn-sm"
                            disabled="@(busy ||
                                        item.Role == item.SelectedRole ||
                                        (isCurrentAdmin &&
                                         item.SelectedRole != ApplicationRoles.Admin))"
                            @onclick="() => ChangeRoleAsync(item)">
                        @T["Save"]
                    </button>
                    <button class="btn btn-danger btn-sm" disabled="@(busy || isCurrentAdmin)" @onclick="() => deleteEntry = item">
                        @T["Delete"]
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (deleteEntry is not null) {
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@T["Delete user"]</h5>
                    <button type="button" class="btn-close" disabled="@busy" @onclick="() => deleteEntry = null"></button>
                </div>
                <div class="modal-body">
                    <p>@T["Do you really want to permanently delete the following user?"]</p>
                    <strong>@deleteEntry.Email</strong>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" disabled="@busy" @onclick="() => deleteEntry = null">
                        @T["Cancel"]
                    </button>
                    <button class="btn btn-danger" disabled="@busy" @onclick="() => DeleteUserAsync(deleteEntry)">
                        @T["Delete"]
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<UserEntry> users = [];
    private string? message;
    private bool isError;
    private bool busy;

    private string? currentUserId;

    private UserEntry? deleteEntry;

    protected override async Task OnInitializedAsync() {
        var authState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        var currentUser = await UserManager.GetUserAsync(authState.User);
        currentUserId = currentUser?.Id;

        await LoadAsync();
    }

    private async Task LoadAsync() {
        var accounts = await UserManager.Users
            .AsNoTracking()
            .OrderBy(u => u.Email)
            .ToListAsync();

        var result = new List<UserEntry>();

        foreach (var user in accounts) {
            var roles = await UserManager.GetRolesAsync(user);

            var role = roles.FirstOrDefault() ?? ApplicationRoles.Guest;

            result.Add(new UserEntry {
                Id = user.Id,
                Email = user.Email ?? "",
                EmailConfirmed = user.EmailConfirmed,
                Role = role,
                SelectedRole = role
            });
        }

        users = result;
    }

    private async Task ChangeRoleAsync(UserEntry entry) {
        if (busy) return;

        busy = true;
        message = null;
        isError = false;

        try {
            var user = await UserManager.FindByIdAsync(entry.Id);

            if (user is null) {
                SetError(T["User not found."]);
                return;
            }

            var newRole = entry.SelectedRole;

            if (!ApplicationRoles.All.Contains(newRole)) {
                SetError(T["Invalid role."]);
                return;
            }

            if (newRole == ApplicationRoles.Registered && !user.EmailConfirmed) {
                SetError(T["Email must be confirmed first."]);
                return;
            }

            var currentRoles = await UserManager.GetRolesAsync(user);

            // Letzten Administrator schützen
            if (currentRoles.Contains(ApplicationRoles.Admin) && newRole != ApplicationRoles.Admin) {
                var admins = await UserManager.GetUsersInRoleAsync(
                    ApplicationRoles.Admin);

                if (admins.Count <= 1) {
                    SetError(T["The last administrator cannot be demoted."]);
                    return;
                }
            }

            // Neue Rolle zuerst vergeben
            if (!currentRoles.Contains(newRole)) {
                var addResult = await UserManager.AddToRoleAsync(user, newRole);

                if (!addResult.Succeeded) {
                    SetError(string.Join("; ", addResult.Errors.Select(e => e.Description)));
                    return;
                }
            }

            // Andere Rollen entfernen
            var rolesToRemove = currentRoles
                .Where(r => r != newRole)
                .ToArray();

            if (rolesToRemove.Length > 0) {
                var removeResult = await UserManager.RemoveFromRolesAsync(user, rolesToRemove);

                if (!removeResult.Succeeded) {
                    SetError(string.Join("; ", removeResult.Errors.Select(e => e.Description)));
                    return;
                }
            }

            var stampResult = await UserManager.UpdateSecurityStampAsync(user);

            if (!stampResult.Succeeded) {
                SetError(string.Join("; ", stampResult.Errors.Select(e => e.Description)));
                return;
            }

            message = T["{0}: Role changed to {1}.", user.Email!, newRole];

            await LoadAsync();
        } catch (Exception ex) {
            SetError(T["Error changing role: {0}", ex.Message]);
        } finally {
            busy = false;
        }
    }

    private async Task ChangeEmailConfirmedAsync(UserEntry entry, bool confirmed) {
        if (busy) return;

        if (entry.Id == currentUserId) {
            SetError(T["You cannot change your own email confirmation."]);
            return;
        }

        busy = true;
        message = null;
        isError = false;

        try {
            var user = await UserManager.FindByIdAsync(entry.Id);

            if (user is null) {
                SetError(T["User not found."]);
                return;
            }

            if (user.EmailConfirmed == confirmed) return;

            user.EmailConfirmed = confirmed;

            var result = await UserManager.UpdateAsync(user);

            if (!result.Succeeded) {
                SetError(string.Join("; ", result.Errors.Select(e => e.Description)));
                return;
            }

            var stampResult = await UserManager.UpdateSecurityStampAsync(user);

            if (!stampResult.Succeeded) {
                SetError(string.Join("; ", stampResult.Errors.Select(e => e.Description)));
                return;
            }

            message = confirmed
                ? T["{0}: Email address confirmed.", user.Email!]
                : T["{0}: Email confirmation revoked.", user.Email!];
        } catch (Exception ex) {
            SetError(T["Error changing email confirmation: {0}", ex.Message]);
        } finally {
            await LoadAsync();
            busy = false;
        }
    }

    private async Task DeleteUserAsync(UserEntry entry) {
        if (busy) return;

        if (entry.Id == currentUserId) {
            SetError(T["You cannot delete your own account."]);
            deleteEntry = null;
            return;
        }

        busy = true;
        message = null;
        isError = false;

        try {
            var user = await UserManager.FindByIdAsync(entry.Id);

            if (user is null) {
                SetError(T["User not found."]);
                return;
            }

            var roles = await UserManager.GetRolesAsync(user);

            // Letzten Administrator schützen
            if (roles.Contains(ApplicationRoles.Admin)) {
                var admins = await UserManager.GetUsersInRoleAsync(ApplicationRoles.Admin);

                if (admins.Count <= 1) {
                    SetError(T["The last administrator cannot be deleted."]);
                    return;
                }
            }

            var result = await UserManager.DeleteAsync(user);

            if (!result.Succeeded) {
                SetError(string.Join("; ", result.Errors.Select(e => e.Description)));
                return;
            }

            message = T["{0}: User deleted.", entry.Email];
            deleteEntry = null;

            await LoadAsync();
        } catch (Exception ex) {
            SetError(T["Error deleting user: {0}", ex.Message]);
        } finally {
            busy = false;
        }
    }

    private void SetError(string text) {
        message = text;
        isError = true;
    }

    private sealed class UserEntry {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public bool EmailConfirmed { get; set; }
        public string Role { get; set; } = "";
        public string SelectedRole { get; set; } = "";
    }
}