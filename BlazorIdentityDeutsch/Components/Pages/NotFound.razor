@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityTexts> T

@page "/not-found"

@layout MainLayout
<PageTitle>@T["Not found"]</PageTitle>

<div class="page-title">
    <span class="bid bid-question-octagon" aria-hidden="true"></span>
    <span>@T["Not found"]</span>
</div>
<p>@T["Sorry, the content you are looking for does not exist."]</p>