@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityTexts> T
@page "/counter"
@rendermode InteractiveServer

<PageTitle>@T["Counter"]</PageTitle>

<div class="page-title">
    <span class="bid bid-house-door-fill" aria-hidden="true"></span>
    <span>@T["Counter"]</span>
</div>

<p role="status">@T["Current count:"] @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">@T["Click me"]</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
