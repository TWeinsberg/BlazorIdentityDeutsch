@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityTexts> T
@page "/auth"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>@T["Auth"]</PageTitle>
<div class="page-title">
    <span class="bid bid-unlock" aria-hidden="true"></span>
    <span>@T["You are authenticated"]</span>
</div>

<AuthorizeView>
    @T["Hello"] @context.User.Identity?.Name!
</AuthorizeView>
